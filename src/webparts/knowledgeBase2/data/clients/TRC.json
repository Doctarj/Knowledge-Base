      {
       "type": "sub",
       "text": "Installing Printers on workstations"
      },
      {
       "type": "step",
       "num": 1,
       "text": "Find the name of the printer to be installed in the \\\\resfiles"
      },
      {
       "type": "step",
       "num": 2,
       "text": "Make sure that the user has the relevant group membership for the printer to be used (Administration, Fitness, etc.)."
      },
      {
       "type": "step",
       "num": 3,
       "text": "In File Explorer, put \\\\resfiles into the File Explorer and this should bring up a list of all printers that are available to the user account."
      },
      {
       "type": "step",
       "num": 4,
       "text": "Find the printer to be installed and double-click it to automatically install the printer drivers."
      },
      {
       "type": "step",
       "num": 5,
       "text": "Send a test print to the printer in Settings to verify its connectivity."
      }
     ]
